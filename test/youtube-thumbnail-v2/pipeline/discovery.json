        "severity": "medium",
        "mitigation": "로컬 diffusers 실행 fallback 또는 생성 결과 캐싱"
      },
      {
        "risk": "AI 단독 운영 시 3주 내 CTR 0.7~2.3p 하락 (31% 사례)",
        "severity": "high",
        "mitigation": "사람 최종 승인 단계 유지 (Phase A에서 semi 아닌 full 선택 시 모니터링 강화)"
      },
      {
        "risk": "YouTube API 일 quota 소진 (10,000 units, thumbnails.set = 50 units)",
        "severity": "low",
        "mitigation": "일 200개 업로드 한도 내 운영, 배치 처리"
      },
      {
        "risk": "GPU 부재 시 SDXL 생성 속도 저하 (CPU: ~10분/장)",
        "severity": "medium",
        "mitigation": "HF Inference API 사용 또는 Docker GPU 컨테이너 설정"
      },
      {
        "risk": "YouTube 정책 위반 (오해의 소지, 클릭베이트)",
        "severity": "high",
        "mitigation": "정책 체크리스트 자동화 + 수동 검토 레이어"
      },
      {
        "risk": "저작권 침해 (무단 이미지/폰트)",
        "severity": "high",
        "mitigation": "Google Fonts (CC0), Unsplash/Pexels (CC0) 소재만 사용"
      }
    ]
  },
