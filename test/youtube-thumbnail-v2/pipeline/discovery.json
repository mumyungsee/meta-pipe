{
  "version": "2.0",
  "phase": "B",
  "created_at": "2026-04-04T00:02:00Z",
  "summary": "6단계 파이프라인: 메타데이터→SDXL생성→Pillow합성→검증→A/B변형→YouTube업로드. 주요 도구: itzzdeep/youtube-thumbnails-sdxl-lora-v3, diffusers, Pillow, google-api-python-client. 핵심 리스크: HF rate limit(무료), AI단독 CTR하락, 저작권.",

  "domain_knowledge": {
    "glossary": [
      { "term": "CTR", "definition": "Click-Through Rate. 섬네일 노출 대비 클릭 비율. YouTube 알고리즘 핵심 지표." },
      { "term": "Safe Zone", "definition": "텍스트/얼굴 배치 안전 영역. 중앙 1235×338 px (하단 우측 시간 오버레이 겹침 주의)." },
      { "term": "LoRA", "definition": "Low-Rank Adaptation. SD 모델을 특정 스타일로 파인튜닝한 경량 어댑터." },
      { "term": "SDXL", "definition": "Stable Diffusion XL. 고해상도 이미지 생성 기반 모델." },
      { "term": "Thumbnail Impression", "definition": "섬네일이 추천 피드에 노출된 횟수." },
      { "term": "Text Treatment", "definition": "섬네일 텍스트 스타일 (폰트, 색상, 아웃라인) 설정." },
      { "term": "Contrast Ratio", "definition": "텍스트-배경 명암비. WCAG AA 기준 4.5:1 이상 = 가독성 기준." },
      { "term": "thumbnails.set", "definition": "YouTube Data API v3 엔드포인트. 영상 섬네일 업로드. 50 units/요청." }
    ],
    "workflows": [
      {
        "name": "유튜브 섬네일 전자동 파이프라인 (6단계)",
        "steps": [
          "메타데이터 수집 (영상 제목/설명/태그)",
          "SDXL LoRA 이미지 생성 (프롬프트 엔지니어링)",
          "Pillow 텍스트 오버레이 합성 (Safe Zone 준수)",
          "품질 검증 (해상도, 파일 크기, 명암비, 정책)",
          "A/B 변형 생성 (2~3개 섬네일)",
          "YouTube Data API v3 업로드 (thumbnails.set)"
        ]
      }
    ],
    "tech_stack": [
      { "tool": "itzzdeep/youtube-thumbnails-sdxl-lora-v3", "purpose": "섬네일 특화 SDXL LoRA 모델 (HuggingFace)", "cost": "무료" },
      { "tool": "diffusers", "purpose": "HuggingFace 이미지 생성 파이프라인 (AutoPipelineForText2Image)", "cost": "무료" },
      { "tool": "torch", "purpose": "PyTorch 딥러닝 백엔드", "cost": "무료" },
      { "tool": "safetensors", "purpose": "LoRA 가중치 로딩", "cost": "무료" },
      { "tool": "Pillow", "purpose": "텍스트 오버레이, 리사이즈, 포맷 변환", "cost": "무료" },
      { "tool": "opencv-python", "purpose": "명암비 측정, 이미지 분석", "cost": "무료" },
      { "tool": "google-api-python-client", "purpose": "YouTube Data API v3 래퍼", "cost": "무료" },
      { "tool": "google-auth-oauthlib", "purpose": "OAuth 2.0 인증", "cost": "무료" }
    ],
    "data_model": [
      {
        "entity": "ThumbnailAsset",
        "fields": ["video_id", "variant_id", "file_path", "format", "width", "height", "file_size_bytes", "created_at"],
        "relationships": ["GenerationConfig로 생성됨", "ValidationResult로 검증됨"]
      },
      {
        "entity": "GenerationConfig",
        "fields": ["prompt", "negative_prompt", "model_id", "lora_scale", "seed"],
        "relationships": ["ThumbnailAsset 1개 이상 생성"]
      },
      {
        "entity": "TextOverlay",
        "fields": ["text", "font_path", "font_size", "color", "outline_color", "position_x", "position_y"],
        "relationships": ["ThumbnailAsset에 합성됨"]
      },
      {
        "entity": "ValidationResult",
        "fields": ["resolution_ok", "file_size_ok", "contrast_ratio", "policy_flags", "overall_pass"],
        "relationships": ["ThumbnailAsset 1:1 연결"]
      }
    ],
    "risks": [
      {
